<span class="akka-doc-switch" role="note">You're reading the <b>SDK</b> docs&nbsp;&middot; <a href="https://doc.akka.io/libraries/akka-dependencies/current/overview.html" target="new">Switch to Libraries</a></span>
<style>
  .akka-doc-switch{font-size:.82rem;line-height:1.4;color:rgba(255,255,255,.62);white-space:nowrap;align-self:center}
  .akka-doc-switch b{color:#fff;font-weight:600}
  .akka-doc-switch a{color:rgba(255,255,255,.62);text-decoration:none;border-bottom:1px solid rgba(255,255,255,.22);padding-bottom:1px;transition:color .15s,border-color .15s}
  .akka-doc-switch a:hover{color:#fff;border-bottom-color:#fff}
  @media (max-width:1024px){.akka-doc-switch{display:none}}
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var bar = document.querySelector('.akka-doc-switch');
    var top = document.querySelector('#topbar-nav');
    if (bar && top && bar.parentNode !== top) { top.insertBefore(bar, top.firstChild); }
  });
</script>
